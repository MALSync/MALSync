{
  "compilerOptions": {
    "rootDir": ".",
    "noImplicitAny": false,
    "noImplicitThis": false,
    "module": "commonjs",
    "target": "es6",
    "lib": ["es5", "es6", "es2015.collection", "es2015.iterable", "dom"],
    "jsx": "react",
    "allowJs": true,
    "sourceMap": true,
    "strict": true,
    "useUnknownInCatchVariables": false,
    "types": ["chrome", "jquery", "node", "mocha", "chai"]
  }
}
